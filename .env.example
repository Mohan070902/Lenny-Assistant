# ==========================================
# The Lenny Growth Assistant - Environment Configuration
# ==========================================

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=lenny_assistant
DATABASE_URL=postgresql+asyncpg://postgres:password123@localhost:5432/lenny_assistant

# Local Model (Ollama) Configuration [MANDATORY FOR DEMO]
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Default Provider ("ollama" or "cloud")
DEFAULT_LLM_PROVIDER=ollama

# Cloud Providers (Optional / Fallback)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Embeddings & Retrieval
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.55
TOP_K_RETRIEVAL=5
